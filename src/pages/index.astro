---
import { eq } from "drizzle-orm";
import { AlbumsGrid } from "../components/AlbumsGrid";
import ThemeScript from "../components/ThemeScript.astro";
import { Wrapper } from "../components/Wrapper";
import { db } from "../db";
import { albums, artists } from "../db/schema";
import type { GridData } from "../types/album";
import { frontendTracer, loggy, metrics } from "../util/loggy";

const span = frontendTracer.startSpan("page.index", {
  kind: "server",
  attributes: { "http.route": "/", "page.name": "index" },
});
const end = metrics.startRequest();

loggy.log("Loading index page", {
  page: "/",
  component: "index",
  traceId: span.context.traceId,
  spanId: span.context.spanId,
});

const dbSpan = frontendTracer.startSpan("db.get_albums", {
  parent: span.context,
  attributes: { "db.operation": "select", "db.table": "albums" },
});

const res = await db
  .select()
  .from(albums)
  .leftJoin(artists, eq(albums.artistId, artists.id));

dbSpan.setAttribute("db.result_count", res.length);
dbSpan.setStatus("ok");
dbSpan.end();

loggy.info("Albums loaded", {
  count: res.length,
  traceId: span.context.traceId,
  spanId: span.context.spanId,
});

end({
  path: "/",
  method: "GET",
  statusCode: Astro.response.status,
  bytesIn: parseInt(Astro.request.headers.get("content-length") || "0"),
  bytesOut: res.length,
});

span.setStatus("ok");
span.end();
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Disco</title>
    <ThemeScript />
  </head>
  <body>
    <Wrapper client:load currentPage={Astro.url.pathname}>
      {
        res.length > 0 && (
          <AlbumsGrid client:only="react" data={res as GridData} />
        )
      }
    </Wrapper>
  </body>
</html>
