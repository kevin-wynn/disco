---
import { isNull } from "drizzle-orm";
import { ArtistsGrid } from "../components/ArtistsGrid";
import ThemeScript from "../components/ThemeScript.astro";
import { Wrapper } from "../components/Wrapper";
import { db } from "../db";
import { artists } from "../db/schema";

const res = await db.select().from(artists).where(isNull(artists.deletedAt));
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Disco - Artists</title>
    <ThemeScript />
  </head>
  <body>
    <Wrapper client:load currentPage={Astro.url.pathname}>
      {
        res.length > 0 ? (
          <ArtistsGrid
            client:only="react"
            data={res.map((artist) => ({
              id: artist.id,
              name: artist.name || "",
              imageUrl: artist.imageUrl || "",
              discogsId: artist.discogsId || 0,
              deletedAt: artist.deletedAt || undefined,
              profile: artist.profile || undefined,
              urls: artist.urls
                ? typeof artist.urls === "string"
                  ? JSON.parse(artist.urls)
                  : artist.urls
                : [],
              nameVariations: artist.nameVariations
                ? typeof artist.nameVariations === "string"
                  ? JSON.parse(artist.nameVariations)
                  : artist.nameVariations
                : [],
              members: artist.members
                ? typeof artist.members === "string"
                  ? JSON.parse(artist.members)
                  : artist.members
                : [],
              dataQuality: artist.dataQuality || undefined,
            }))}
          />
        ) : (
          <div class="text-center py-8 text-gray-400">
            No artists in your library yet.
          </div>
        )
      }
    </Wrapper>
  </body>
</html>
