---
import { SettingsPanel } from "../components/Settings";
import ThemeScript from "../components/ThemeScript.astro";
import { Wrapper } from "../components/Wrapper";
import { frontendTracer, loggy } from "../util/loggy";

const span = frontendTracer.startSpan("page.settings", {
  kind: "server",
  attributes: { "http.route": "/settings", "page.name": "settings" },
});

loggy.log("Loading settings page", {
  page: "/settings",
  component: "settings",
  traceId: span.context.traceId,
  spanId: span.context.spanId,
});

span.setStatus("ok");
span.end();
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Disco - Settings</title>
    <ThemeScript />
  </head>
  <body>
    <Wrapper client:load currentPage={Astro.url.pathname}>
      <SettingsPanel client:load />
    </Wrapper>
  </body>
</html>
