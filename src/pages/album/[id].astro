---
import { eq } from "drizzle-orm";
import {
  AlbumWithTracks,
  type AlbumData,
} from "../../components/AlbumWithTracks";
import ThemeScript from "../../components/ThemeScript.astro";
import { Wrapper } from "../../components/Wrapper";
import { db } from "../../db";
import { albums, artists, tracks, type Track } from "../../db/schema";
import { frontendTracer, loggy } from "../../util/loggy";

const { id } = Astro.params;

const span = frontendTracer.startSpan("page.album_detail", {
  kind: "server",
  attributes: {
    "http.route": "/album/[id]",
    "page.name": "album_detail",
    "album.id": id ?? "unknown",
  },
});

loggy.log(`Loading album page`, {
  page: "/album",
  albumId: id,
  traceId: span.context.traceId,
  spanId: span.context.spanId,
});

let album: AlbumData | undefined;

if (!id) {
  loggy.error("Album page accessed without id", {
    page: "/album",
    error: "missing_id",
    traceId: span.context.traceId,
    spanId: span.context.spanId,
  });
  span.setStatus("error", "Album ID missing");
  span.end();
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
} else {
  const dbSpan = frontendTracer.startSpan("db.get_album_with_tracks", {
    parent: span.context,
    attributes: { "db.operation": "select", "album.id": parseInt(id) },
  });

  const res = await db
    .select()
    .from(albums)
    .where(eq(albums.id, parseInt(id)))
    .leftJoin(artists, eq(albums.artistId, artists.id))
    .leftJoin(tracks, eq(tracks.albumId, parseInt(id)));

  dbSpan.setStatus("ok");
  dbSpan.end();

  const allTracks = res
    .map((item) => item.tracks)
    .filter((track): track is Track => track !== null);

  album = {
    ...res[0].albums,
    artists: res[0].artists,
    tracks: allTracks,
  };

  loggy.info(`Loaded album: ${album.title}`, {
    albumId: id,
    title: album.title,
    trackCount: allTracks.length,
    artist: Array.isArray(album.artists)
      ? album.artists[0]?.name
      : album.artists?.name,
    traceId: span.context.traceId,
    spanId: span.context.spanId,
  });

  span.setAttribute("album.title", album.title ?? "Unknown");
  span.setAttribute("album.track_count", allTracks.length);
  span.setStatus("ok");
  span.end();
}
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Disco</title>
    <ThemeScript />
  </head>
  <body>
    <Wrapper client:load currentPage={Astro.url.pathname}>
      <AlbumWithTracks client:load album={album as AlbumData} />
    </Wrapper>
  </body>
</html>
