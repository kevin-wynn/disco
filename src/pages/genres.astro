---
import { eq } from "drizzle-orm";
import { GenresGrid } from "../components/GenresGrid";
import ThemeScript from "../components/ThemeScript.astro";
import { Wrapper } from "../components/Wrapper";
import { db } from "../db";
import { albums, artists } from "../db/schema";
import type { GridData } from "../types/album";
import { frontendTracer, loggy, metrics } from "../util/loggy";

const span = frontendTracer.startSpan("page.genres", {
  kind: "server",
  attributes: { "http.route": "/genres", "page.name": "genres" },
});
const end = metrics.startRequest();

loggy.log("Loading genres page", {
  page: "/genres",
  component: "genres",
  traceId: span.context.traceId,
  spanId: span.context.spanId,
});

const dbSpan = frontendTracer.startSpan("db.get_albums_for_genres", {
  parent: span.context,
  attributes: { "db.operation": "select", "db.table": "albums" },
});

const res = await db
  .select()
  .from(albums)
  .leftJoin(artists, eq(albums.artistId, artists.id));

dbSpan.setAttribute("db.result_count", res.length);
dbSpan.setStatus("ok");
dbSpan.end();

res.length === 0
  ? loggy.warn("No albums found for genres view", {
      count: 0,
      traceId: span.context.traceId,
      spanId: span.context.spanId,
    })
  : loggy.info(`Found ${res.length} albums for genres`, {
      count: res.length,
      traceId: span.context.traceId,
      spanId: span.context.spanId,
    });

end({
  path: "/genres",
  method: "GET",
  statusCode: Astro.response.status,
  bytesIn: parseInt(Astro.request.headers.get("content-length") || "0"),
  bytesOut: res.length,
});

span.setStatus("ok");
span.end();
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Disco - Genres</title>
    <ThemeScript />
  </head>
  <body>
    <Wrapper client:load currentPage={Astro.url.pathname}>
      {
        res.length > 0 ? (
          <GenresGrid client:only="react" data={res as GridData} />
        ) : (
          <div class="text-center py-8 text-gray-400">
            No albums in your library yet.
          </div>
        )
      }
    </Wrapper>
  </body>
</html>
